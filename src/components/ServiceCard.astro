---
type Props = {
  title: string;
  duration: string;
  price: string;
  tiers?: { label: string; price: string }[];
  theme: string;
  includes: string[];
  actionLabel?: string;
  href?: string;
  external?: boolean;
};

const { title, duration, price, tiers = [], theme, includes, actionLabel = "Reserve Session", href = "/booking/", external = false } = Astro.props;
---

<article class="service-card">
  <div class="service-meta">
    <span>{duration}</span>
    <strong>{price}</strong>
  </div>
  <h3>{title}</h3>
  <p>{theme}</p>
  {tiers.length > 0 && (
    <div class="service-tiers">
      {tiers.map((tier) => (
        <div>
          <span>{tier.label}</span>
          <strong>{tier.price}</strong>
        </div>
      ))}
    </div>
  )}
  <ul>
    {includes.map((item) => <li>{item}</li>)}
  </ul>
  <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{actionLabel}</a>
</article>
