---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { contactUrl, faqs, services } from "../data/site";
import { serviceItemListSchema } from "../data/seo";
---

<BaseLayout
  title="Tarot, Lenormand & Rune Reading Services | Mystics Magic"
  description="Compare Mystics Magic reading services with USD pricing: Tarot from USD $20, Lenormand from USD $15, and Elder Futhark Rune readings from USD $15."
  canonicalPath="/services/"
  keywords="tarot reading price USD, Lenormand reading price, Rune reading price, Elder Futhark reading, WhatsApp tarot reading"
  structuredData={serviceItemListSchema}
>
  <section class="page-hero">
    <span class="eyebrow">Services</span>
    <h1>Readings for clarity, guidance, and direction.</h1>
    <p>Compare Tarot, Lenormand, and Rune readings in USD before choosing the service that fits your focused question.</p>
  </section>
  <section class="section light">
    <div class="service-grid">
      {services.map((service) => <ServiceCard {...service} />)}
    </div>
  </section>
  <section class="section">
    <div class="section-intro">
      <div>
        <span class="eyebrow">Before casting</span>
        <h2>What every client should know.</h2>
      </div>
      <p>Readings offer insight, reflection, and possible directions. They are not guaranteed outcomes, and personal choices may influence the final path.</p>
    </div>
    <div class="steps-grid">
      <article class="step">
        <span>01</span>
        <h3>Bring one question</h3>
        <p>Specific questions usually receive the clearest guidance. Broad themes are welcome too.</p>
      </article>
      <article class="step">
        <span>02</span>
        <h3>Use WhatsApp text</h3>
        <p>All readings are handled through WhatsApp text only for privacy and easy reference.</p>
      </article>
      <article class="step">
        <span>03</span>
        <h3>Receive your report</h3>
        <p>Every booking includes a full detailed report in English plus spread or casting images within 2-3 days after payment and details are received.</p>
      </article>
      <article class="step">
        <span>04</span>
        <h3>Reflect gently</h3>
        <p>Readings offer insight and possible directions for guidance and self-reflection.</p>
      </article>
    </div>
    <div class="section-actions">
      <a class="button" href={contactUrl} target="_blank" rel="noopener noreferrer">Book via WhatsApp</a>
      <a class="button-secondary" href="/booking/">View Booking Page</a>
    </div>
  </section>
  <section class="section light">
    <div class="section-intro">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2>Booking questions.</h2>
      </div>
      <p>Clear answers help you choose the right reading and know what to send before casting begins.</p>
    </div>
    <div class="faq-grid">
      {faqs.map((item) => (
        <article class="faq-card">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
