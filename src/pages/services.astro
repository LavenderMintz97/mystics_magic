---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/site";
import { serviceItemListSchema } from "../data/seo";
---

<BaseLayout
  title="Tarot, Lenormand & Rune Reading Services | Mystics Magic"
  description="Compare Mystics Magic reading services with MYR pricing: Tarot from RM 88, Lenormand from RM 68, and Elder Futhark Rune readings from RM 68."
  canonicalPath="/services/"
  keywords="tarot reading price Malaysia, Lenormand reading price, Rune reading price, Elder Futhark reading, MYR tarot reading"
  structuredData={serviceItemListSchema}
>
  <section class="page-hero">
    <span class="eyebrow">Services</span>
    <h1>Readings for clarity, guidance, and direction.</h1>
    <p>Compare Tarot, Lenormand, and Rune readings before choosing the service that fits your focused question.</p>
  </section>
  <section class="section light">
    <div class="service-grid">
      {services.map((service) => <ServiceCard {...service} />)}
    </div>
  </section>
  <section class="section">
    <div class="section-intro">
      <div>
        <span class="eyebrow">Before casting</span>
        <h2>What every client should know.</h2>
      </div>
      <p>Readings offer insight, reflection, and possible directions. They are not guaranteed outcomes, and personal choices may influence the final path.</p>
    </div>
    <div class="steps-grid">
      <article class="step">
        <span>01</span>
        <h3>Bring one question</h3>
        <p>Specific questions usually receive the clearest guidance. Broad themes are welcome too.</p>
      </article>
      <article class="step">
        <span>02</span>
        <h3>Use WhatsApp text</h3>
        <p>All readings are handled through WhatsApp text only for privacy and easy reference.</p>
      </article>
      <article class="step">
        <span>03</span>
        <h3>Receive your report</h3>
        <p>Every booking includes a full detailed report in English plus spread or casting images.</p>
      </article>
      <article class="step">
        <span>04</span>
        <h3>Reflect gently</h3>
        <p>Readings offer insight and possible directions for guidance and self-reflection.</p>
      </article>
    </div>
  </section>
</BaseLayout>
