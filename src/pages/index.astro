---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProductTile from "../components/ProductTile.astro";
import { contactUrl, faqs, journalPosts, paymentUrl, products, services, testimonials } from "../data/site";
import { serviceItemListSchema } from "../data/seo";
---

<BaseLayout
  title="Mystics Magic | Tarot, Lenormand & Rune Readings in USD"
  description="Mystics Magic offers Tarot Reading, Lenormand Reading, and Elder Futhark Rune Reading through WhatsApp text with English reports and clear USD pricing."
  canonicalPath="/"
  keywords="Mystics Magic, tarot reading USD, Lenormand reading online, Rune reading online, WhatsApp tarot reading"
  structuredData={serviceItemListSchema}
>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Tarot, Lenormand, and Rune readings</span>
      <h1>Clarity for the path ahead.</h1>
      <p>Mystics Magic helps clients turn one focused question into clear guidance through Tarot Reading, Lenormand Reading, and Elder Futhark Rune Reading.</p>
      <div class="hero-actions">
        <a class="button" href="/booking/">Book a Reading</a>
        <a class="button-secondary" href={contactUrl} target="_blank" rel="noopener noreferrer">WhatsApp Booking</a>
      </div>
    </div>
    <div class="hero-media">
      <img
        src="/images/tarot-hero-1600.jpg"
        srcset="/images/tarot-hero-960.jpg 960w, /images/tarot-hero-1600.jpg 1600w, /images/tarot-hero-2400.jpg 2400w, /images/tarot-hero-4k.jpg 3840w"
        sizes="(max-width: 720px) calc(100vw - 2rem), (max-width: 1100px) calc(100vw - 2rem), 640px"
        width="1600"
        height="900"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        alt="Mystics Magic tarot reading hero with gold tarot cards, crystals, candlelight, and crescent moon"
      />
      <div class="hero-stamp">
        <span>05</span>
        <p>WhatsApp text-only readings with full English reports and spread images.</p>
      </div>
    </div>
  </section>

  <section class="section light">
    <div class="section-intro">
      <div>
        <span class="eyebrow">Reading pathways</span>
        <h2>Choose the reading that fits your question.</h2>
      </div>
      <p>Each service includes a detailed written report in English and images shared after casting.</p>
    </div>
    <div class="service-grid">
      {services.map((service) => <ServiceCard {...service} />)}
    </div>
  </section>

  <section class="section split">
    <div class="arch-photo" aria-hidden="true"></div>
    <div>
      <span class="eyebrow">Consultation style</span>
      <h2>Soft mysticism, useful answers.</h2>
      <p>Readings are designed for clients who want symbolism, care, and practical direction in the same place. You bring one focused question; the reading stays centered on that question.</p>
      <p>Vanessa reads through a calm, client-centered process that blends intuitive symbolism with clear written guidance. Each report is prepared in English so clients can return to the message, images, and reflection notes after the reading.</p>
      <ul class="ritual-list">
        <li>Full name and date of birth collected before casting.</li>
        <li>Cards, runes, and energy are cleansed before every reading.</li>
        <li>Honest insight for reflection, direction, and empowered decisions.</li>
      </ul>
      <div class="section-actions">
        <a class="button" href="/about/">Meet the Reader</a>
        <a class="button-secondary" href="/testimonials/">Client Stories</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="band-inner">
      <h2>Enquire now for Tarot, Lenormand, or Rune guidance through WhatsApp text only.</h2>
      <a class="button" href={contactUrl} target="_blank" rel="noopener noreferrer">Start on WhatsApp</a>
    </div>
  </section>

  <section class="section light">
    <div class="section-intro">
      <div>
        <span class="eyebrow">Digital shop</span>
        <h2>Digital planners and journals are ready to request.</h2>
      </div>
      <p>Buy printable planners and journals through Ko-fi, then send your selected item through WhatsApp for delivery confirmation.</p>
    </div>
    <div class="product-grid">
      {products.map((product) => <ProductTile {...product} />)}
    </div>
    <div class="section-actions centered-actions">
      <a class="button" href={paymentUrl} target="_blank" rel="noopener noreferrer">Open Ko-fi Shop</a>
      <a class="button-secondary" href={contactUrl} target="_blank" rel="noopener noreferrer">Confirm on WhatsApp</a>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <div>
        <span class="eyebrow">Journal</span>
        <h2>Resources for clearer questions.</h2>
      </div>
      <a class="button-secondary" href="/resources/">Read More</a>
    </div>
    <div class="journal-grid">
      {journalPosts.map((post) => (
        <article class="journal-card">
          <span>{post.category}</span>
          <h3>{post.title}</h3>
          <p>{post.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section light">
    <div class="section-intro">
      <div>
        <span class="eyebrow">Client notes</span>
        <h2>Grounded, warm, specific.</h2>
      </div>
      <a class="button-secondary" href="/booking/">Start Here</a>
    </div>
    <div class="testimonial-grid">
      {testimonials.map((item) => (
        <article class="testimonial">
          <p>"{item.quote}"</p>
          <strong>{item.name}</strong>
          <span>{item.detail}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2>Quick answers before booking.</h2>
      </div>
      <p>These notes help clients understand the text-only process, delivery timing, and USD pricing before sending a request.</p>
    </div>
    <div class="faq-grid">
      {faqs.map((item) => (
        <article class="faq-card">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
